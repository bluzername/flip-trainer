<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- BLE peripheral role. Session 9. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application
        android:name=".FlipTrainerApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlipTrainer">

        <!--
          singleTask + keepScreenOn: the appliance is placed on a tripod and driven without
          main-screen touch. See DEVICE_NOTES.md.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullSensor"
            android:turnScreenOn="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- adb shell am start -a com.fliptrainer.action.SHOW_PAIRING -->
            <intent-filter>
                <action android:name="com.fliptrainer.action.SHOW_PAIRING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".camera.CameraSessionService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <!-- adb shell am broadcast -a com.fliptrainer.action.UNPAIR -->
        <receiver
            android:name=".pairing.RecoveryReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.fliptrainer.action.UNPAIR" />
                <action android:name="com.fliptrainer.action.DUMP_DIAGNOSTICS" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
